# Discord application
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# No Developer Portal, a redirect URI da Activity fica em:
# https://<client_id>.discordsays.com
DISCORD_REDIRECT_URI=

# Client build (baked into the bundle by Vite)
# Falls back to DISCORD_CLIENT_ID when empty.
VITE_DISCORD_CLIENT_ID=

# Server
PORT=3001
SESSION_SECRET=change-me-to-a-long-random-string
DEV_AUTH=true
SKIP_INSTANCE_VALIDATION=true

# Redis gerenciado da Shard (opcional em desenvolvimento)
REDIS_URL=

# Retenção e limites de salas
ROOM_TTL_SECONDS=21600
LOBBY_TTL_SECONDS=900
MAX_ROOMS=2000
MAX_ROOMS_PER_USER=5

# Mantenha true atrás do proxy da Shard: o rate limit usa o IP real do jogador.
TRUST_PROXY=true

# Logs legíveis por padrão. Use LOG_JSON=1 para emitir JSON puro (ingestão externa).
LOG_JSON=
LOG_LEVEL=info

# Em produção, o servidor escuta na porta 80 por padrão.
